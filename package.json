{
  "name": "precificadora3d",
  "version": "1.0.0",
  "private": true,
  "description": "Calculadora de Precificação para Impressão 3D (Taxas 2026)",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "dev:vite-only": "vite --open",
    "build": "vite build",
    "build:vercel": "vite build && rm -rf server/dist-views && mkdir -p server/dist-views && mv dist/index.html dist/admin dist/auth server/dist-views/",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server.js",
    "serve": "npx serve ."
  },
  "devDependencies": {
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  }
}
