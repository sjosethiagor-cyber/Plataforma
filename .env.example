# URL e chaves do seu projeto Supabase (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable-aqui
# Chave secreta usada APENAS no servidor (NUNCA exponha no navegador)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# E-mail do administrador principal (será promovido automaticamente a admin + aprovado)
# Opcional: se omitido, o primeiro usuário cadastrado se torna o administrador.
ADMIN_EMAIL=seu-email-admin@exemplo.com

# URL pública da aplicação (usada para redirect do Link Mágico)
APP_URL=http://localhost:5173
PORT=5173

# Opcional: aviso por e-mail quando o administrador aprovar uma conta (via Resend)
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=3DSJ Precificadora <acesso@seudominio.com.br>

